      "updatedAt": "2026-10-27T09:20:00.000Z",
      "text": "Fixture locator pin was worn 0.11 mm below its minimum diameter",
      "parentId": "aeV7L8agQXZL",
      "origin": "why",
      "evidenceState": "verified",
      "classification": "contributing",
      "challenged": false,
      "candidate": true,
