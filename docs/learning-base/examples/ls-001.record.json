      "order": 1
    },
    {
      "id": "RMvIha78dtw3",
      "createdAt": "2026-10-27T10:10:00.000Z",
      "updatedAt": "2026-10-27T10:10:00.000Z",
      "text": "Hourly in-process check uses a go/no-go plug that passes up to 10.10 mm, and the setup check does not look at the fixture",
      "parentId": "txfX2ZXpJx3I",
      "origin": "why",
      "evidenceState": "data_supported",
      "classification": "contributing",
      "challenged": false,
      "candidate": true,
