      "rationale": {
        "cEULcCLG8Dij": {
          "text": "The portal captures the required fields and the drawing up front, so nothing bounces back for missing information."
        },
        "_G_1pel5N419": {
          "text": "Portal submission creates the CRM record automatically. No one has to sweep an inbox."
        },
        "GaY_JyikRNuf": {
          "text": "The portal validates the drawing and required fields before the customer can submit."
        },
        "Izqsn6mdXGRI": {
          "text": "Estimating triages the queue twice a day and routes to Engineering directly; Sales no longer relays."
        },
        "WgMZCsQQXBpq": {
          "text": "Engineering runs a 15-minute daily triage of the review queue. The two-day wait was queue time, not review time."
        },
        "pSfIDfRkaY8w": {
          "text": "Engineering notes live on the RFQ record; Estimating sees them the moment the review is marked done."
        },
        "s2S8u47SB0Gd": {
          "text": "Estimating is notified from the queue instead of email, so work starts the same half-day."
        },
        "e7o4vwKgLVpe": {
          "text": "Sales approval is required only above $25k. Standard quotes go out from the quote tool, which removes a handoff and a one-day wait."
        },
        "YfXKpB9ILyZq": {
          "text": "The quote carries a 48-hour follow-up and a one-click accept in the portal. Customer decision time is theirs, but the follow-up halves it in the pilot."
        },
        "AxPZRm8B2ndo": {
          "text": "Acceptance in the portal is the PO. No separate PO email to wait for."
        },
        "65gXOo52rqgP": {
          "text": "The ERP sales order is created from the accepted quote record. Nothing is re-keyed, so the typo errors cannot happen."
        },
        "8UqGgA_1RnjE": {
          "text": "The portal sends the acknowledgment automatically when the ERP order exists."
        },
        "5s3gU3P6Y5l4": {
          "text": "Acknowledgment is a system event the customer sees in the portal, not an Order Entry task."
        }
      }
    }
